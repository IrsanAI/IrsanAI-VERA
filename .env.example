# IrsanAI-VERA — Environment Variables
# Copy this file to .env and fill in your tokens.
# .env is in .gitignore — never committed to GitHub.

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only is enough)
# Without this: 10 req/min rate limit → agents find nothing
GITHUB_TOKEN=ghp_your_token_here

# HuggingFace Token (optional — increases rate limits)
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Obsidian Vault Path (optional — default: ./vault)
# Set this to your actual Obsidian vault folder for seamless integration
# Example Windows: C:/Users/irsan.sefer/Documents/ObsidianVault/VERA
# Example: ./vault
OBSIDIAN_VAULT_PATH=./vault
